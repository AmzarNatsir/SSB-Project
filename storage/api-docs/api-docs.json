{
    "openapi": "3.0.0",
    "info": {
        "title": "Unit Request API",
        "description": "API for managing Unit Requests for Workshop use.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "SSB Project API Server"
        }
    ],
    "paths": {
        "/unit-requests": {
            "get": {
                "tags": [
                    "Unit Request"
                ],
                "summary": "List unit requests forwarded to workshop",
                "operationId": "d8dbfc38a85629f8ef9821902c9feb2a",
                "responses": {
                    "200": {
                        "description": "List of forwarded unit requests with items",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/unit-requests/{uid}": {
            "get": {
                "tags": [
                    "Unit Request"
                ],
                "summary": "Get details of a specific unit request",
                "operationId": "3124d7907444dc5a4886bf219792503f",
                "parameters": [
                    {
                        "name": "uid",
                        "in": "path",
                        "description": "UID of the unit request",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Unit request details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/unit-requests/items/{id}/ready": {
            "patch": {
                "tags": [
                    "Unit Request"
                ],
                "summary": "Update readiness status of a unit request item",
                "operationId": "4f4e936183ba8bb674fe3b26bded6590",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the unit request item",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "unit_ready"
                                ],
                                "properties": {
                                    "unit_ready": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "operator_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "operator_name": {
                                        "type": "string",
                                        "example": "Operator Name"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Readiness status updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Item not found"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Unit Request",
            "description": "Unit Request"
        }
    ]
}